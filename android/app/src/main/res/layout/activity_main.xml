<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050608"
        android:overScrollMode="never" />

    <!-- Covers the WebView while a page loads so it never shows blank or Android's error page.
         v11: no spinner or «در حال اتصال…» text; the same logo B as the launch splash, so a reload, the host move
         or a fallback looks like the splash. Hidden at the first paint (onPageCommitVisible), not at load. -->
    <FrameLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050608"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />
    </FrameLayout>
</FrameLayout>
