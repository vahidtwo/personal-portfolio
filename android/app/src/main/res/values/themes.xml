<resources>
    <style name="Theme.MyInventory" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#050608</item>
        <item name="android:statusBarColor">#050608</item>
        <item name="android:navigationBarColor">#050608</item>
    </style>
    <!-- v11: native launch splash (androidx core-splashscreen), logo B on the app background. MainActivity keeps
         it up until the WebView's first paint (onPageCommitVisible), at most SPLASH_MAX_MS. -->
    <style name="Theme.MyInventory.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#050608</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#3ee0b8</item>
        <item name="postSplashScreenTheme">@style/Theme.MyInventory</item>
    </style>
    <!-- Update notice bottom sheet: dimmed scrim (#050608 at 62%), fade only. -->
    <style name="Theme.MyInventory.UpdateSheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
