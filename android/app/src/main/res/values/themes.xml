<resources>
    <style name="Theme.MyInventory" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#050608</item>
        <item name="android:statusBarColor">#050608</item>
        <item name="android:navigationBarColor">#050608</item>
    </style>
    <!-- Update notice bottom sheet: dimmed scrim (#050608 at 62%), fade only. -->
    <style name="Theme.MyInventory.UpdateSheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
