<?xml version="1.0" encoding="utf-8"?>
<!-- Update notice bottom sheet (design: mockups/update-notice, states 1-4). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/update_sheet_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:id="@+id/sheet_drag"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:importantForAccessibility="no">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/update_handle" />
    </FrameLayout>

    <app.myinventory.MaxHeightScrollView
        android:id="@+id/sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sheet_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/sheet_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sheet_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:focusable="true"
                        android:textAlignment="viewStart"
                        android:textColor="@color/update_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sheet_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/update_text_muted"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheet_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/update_notes_bg"
                android:orientation="vertical"
                android:padding="14dp" />

            <TextView
                android:id="@+id/sheet_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/update_chip_ok"
                android:drawableStart="@drawable/ic_update_shield"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/update_ready_chip"
                android:textColor="@color/update_ok"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/sheet_progress_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/sheet_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layoutDirection="rtl"
                    android:max="100"
                    android:progressDrawable="@drawable/update_progress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sheet_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textColor="@color/update_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/sheet_mb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/update_text_muted"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/sheet_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                android:textColor="@color/update_text_soft"
                android:textSize="14.5sp" />

            <LinearLayout
                android:id="@+id/sheet_callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/update_callout_bg"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_update_callout" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/update_ready_callout"
                    android:textAlignment="viewStart"
                    android:textColor="@color/update_text"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>
    </app.myinventory.MaxHeightScrollView>

    <LinearLayout
        android:id="@+id/sheet_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/sheet_primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/update_btn_primary"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/update_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sheet_secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/update_btn_ghost"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/update_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_fine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:breakStrategy="balanced"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/update_available_fine"
        android:textColor="@color/update_text_muted"
        android:textSize="12.5sp" />
</LinearLayout>
