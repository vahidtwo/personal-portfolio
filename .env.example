SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated usernames allowed to open /admin (lowercase)
ADMIN_USERNAMES=yourusername
HTTPS_ONLY=0
DATA_DIR=/app/data
CHANDE_URL=https://chande.net/api/v1/prices/current
PRICE_REFRESH_HOURS=1
PRICE_MANUAL_REFRESH_MINUTES=5
ENABLE_INTERNAL_SCHEDULER=1

# Firebase web push (public client config — safe in browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Firebase Admin (server only — never commit real values)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
