#!/bin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x /opt/gradle/bin/gradle ]; then
  GRADLE_HOME=/opt/gradle
elif [ -x /tmp/android-build/gradle-8.7/bin/gradle ]; then
  GRADLE_HOME=/tmp/android-build/gradle-8.7
else
  GRADLE_HOME="${GRADLE_HOME:-/opt/gradle}"
fi
export ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
if [ -z "${JAVA_HOME:-}" ] && command -v java >/dev/null 2>&1; then
  JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)" 2>/dev/null || command -v java)")")"
  export JAVA_HOME
fi
exec "$GRADLE_HOME/bin/gradle" -p "$DIR" "$@"
